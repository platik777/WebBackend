<!-- Обновленная страница корзины views/cart.hbs -->
<div class="cart-page">
  <h1 class="page-title">Корзина</h1>

  <div class="cart-content">
    <div class="cart-items" id="cartItems">
      <!-- Товары будут загружены через JavaScript -->
      <div class="cart-loading">
        <div class="loading-spinner"></div>
        <p>Загрузка корзины...</p>
      </div>
    </div>

    <div class="cart-summary">
      <div class="summary-card">
        <h3>Итого</h3>
        <div class="summary-line">
          <span>Товары:</span>
          <span id="itemsTotal">0 ₽</span>
        </div>
        <div class="summary-line">
          <span>Доставка:</span>
          <span id="shippingCost">Рассчитывается</span>
        </div>
        <div class="summary-line total">
          <span>К оплате:</span>
          <span id="totalAmount">0 ₽</span>
        </div>

        <div class="delivery-info" id="deliveryInfo" style="display: none;">
          <div class="info-item">
            <i class="fas fa-truck"></i>
            <span>Бесплатная доставка от 1000 ₽</span>
          </div>
          <div class="info-item">
            <i class="fas fa-clock"></i>
            <span>Доставка 1-3 рабочих дня</span>
          </div>
        </div>

        <button class="btn btn-primary btn-large checkout-btn" id="checkoutBtn" disabled>
          Перейти к оформлению
        </button>

        <div class="cart-actions">
          <button class="btn btn-outline clear-cart-btn" id="clearCartBtn">
            <i class="fas fa-trash"></i>
            Очистить корзину
          </button>
          <a href="/catalog" class="btn btn-outline">
            <i class="fas fa-arrow-left"></i>
            Продолжить покупки
          </a>
        </div>

        <div class="payment-methods">
          <h4>Принимаем к оплате:</h4>
          <div class="payment-icons">
            <i class="fab fa-cc-visa"></i>
            <i class="fab fa-cc-mastercard"></i>
            <i class="fab fa-cc-paypal"></i>
            <i class="fas fa-money-bill-wave"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="empty-cart" id="emptyCart" style="display: none;">
    <div class="empty-state">
      <i class="fas fa-shopping-cart"></i>
      <h3>Ваша корзина пуста</h3>
      <p>Добавьте товары из каталога, чтобы оформить заказ</p>
      <a href="/catalog" class="btn btn-primary">Перейти в каталог</a>
    </div>
  </div>

  <!-- Модальное окно подтверждения очистки корзины -->
  <div class="modal" id="clearCartModal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3>Очистить корзину?</h3>
        <button class="modal-close" onclick="closeClearCartModal()">&times;</button>
      </div>
      <div class="modal-body">
        <p>Вы уверены, что хотите удалить все товары из корзины?</p>
        <p><small>Это действие нельзя отменить.</small></p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline" onclick="closeClearCartModal()">Отмена</button>
        <button class="btn btn-danger" onclick="confirmClearCart()">Очистить</button>
      </div>
    </div>
  </div>

  <div class="recommended-section" id="recommendedSection" style="display: none;">
    <h2>Рекомендуем также</h2>
    <div class="recommended-grid" id="recommendedItems">
      <!-- Рекомендуемые товары будут загружены через JavaScript -->
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    initCartPage();
  });

  async function initCartPage() {
    await loadCartItems();
    await loadRecommendedItems();
    initCartEventListeners();
  }

  function initCartEventListeners() {
    // Кнопка оформления заказа
    const checkoutBtn = document.getElementById('checkoutBtn');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', () => {
        window.location.href = '/checkout';
      });
    }

    // Кнопка очистки корзины
    const clearCartBtn = document.getElementById('clearCartBtn');
    if (clearCartBtn) {
      clearCartBtn.addEventListener('click', showClearCartModal);
    }
  }

  async function loadRecommendedItems() {
    try {
      // Загружаем рекомендуемые товары
      const response = await fetch('/api/manga/featured');
      if (response.ok) {
        const featured = await response.json();
        displayRecommendedItems(featured.slice(0, 4)); // Показываем 4 товара
      }
    } catch (error) {
      console.error('Error loading recommended items:', error);
    }
  }

  function displayRecommendedItems(items) {
    const container = document.getElementById('recommendedItems');
    const section = document.getElementById('recommendedSection');

    if (!container || !items.length) return;

    container.innerHTML = items.map(manga => `
      <div class="recommended-item">
        <div class="item-image">
          <img src="${manga.imageUrl || '/images/placeholder.jpg'}" alt="${manga.title}">
        </div>
        <div class="item-info">
          <h4><a href="/manga/${manga.id}">${manga.title}</a></h4>
          <div class="item-price">${formatPrice(manga.price)}</div>
          <button class="btn btn-sm btn-primary" onclick="addToCart(${manga.id})">
            В корзину
          </button>
        </div>
      </div>
    `).join('');

    section.style.display = 'block';
  }

  function showClearCartModal() {
    document.getElementById('clearCartModal').style.display = 'block';
  }

  function closeClearCartModal() {
    document.getElementById('clearCartModal').style.display = 'none';
  }

  async function confirmClearCart() {
    try {
      const response = await fetch(`/api/cart/${getSessionId()}/clear`, {
        method: 'DELETE'
      });

      if (response.ok) {
        closeClearCartModal();
        showNotification('Корзина очищена', 'success');
        await loadCartItems();
        await updateCartCounter();
      } else {
        throw new Error('Ошибка при очистке корзины');
      }
    } catch (error) {
      showNotification(error.message, 'error');
    }
  }

  // Закрытие модального окна при клике вне его
  window.onclick = function(event) {
    const modal = document.getElementById('clearCartModal');
    if (event.target === modal) {
      closeClearCartModal();
    }
  }
</script>